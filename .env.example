# ============================================================
# KONKAN BAZAAR — UNIVERSAL ENVIRONMENT FILE
# ONE file for the whole project. Backend + frontend both read this.
# NEVER commit this file (it contains real secrets).
# Copy .env.example to .env to start fresh.
# ============================================================

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_USER=root
DB_PASS=root123
DB_NAME=konkan_bazaar

# ---- JWT Authentication ----
JWT_SECRET=your_jwt_secret_key_change_this
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_this

# ---- Public URLs ----
# Frontend origin(s). First entry is also the post-OAuth-login redirect target.
FRONTEND_URL=http://localhost:3000,http://localhost:3001
# Backend public URL — must match the OAuth redirect URIs whitelisted in the consoles.
BACKEND_URL=http://localhost:5000

# ---- Admin Panel ----
ADMIN_PANEL_PASSWORD=GYPKXDpU9RGJnbGvy4%@vTQG

# ---- Razorpay Payment Gateway ----
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ---- SMTP / Email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=hello@konkanbazaar.in

# ---- Rate Limiting ----
API_RATE_LIMIT=1000

# ---- Google OAuth (from Google Cloud Console) ----
GOOGLE_CLIENT_ID=320665513907-3ds33g62qj9bbk5rk0vecoqhctqkfgrv.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# ---- Facebook OAuth (from Facebook Developer Console) ----
FACEBOOK_APP_ID=1527919321996692
FACEBOOK_APP_SECRET=38eaed043b53a996fc4485bf477a2c7d

# ---- Frontend (NEXT_PUBLIC_* get inlined into the browser bundle) ----
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
NEXT_PUBLIC_ADMIN_KEY=sakshisawant
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Deployment (Railway) ----
