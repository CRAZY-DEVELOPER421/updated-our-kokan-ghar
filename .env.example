# ============================================================
# KONKAN BAZAAR — UNIVERSAL ENVIRONMENT TEMPLATE
# ONE file for the whole project. Backend + frontend both read this.
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# NEVER commit the real .env file (it contains live secrets).
# This .env.example template is safe to commit — placeholders only.
# ============================================================

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (MySQL) ----
DB_HOST=localhost
DB_USER=root
DB_PASS=your_db_password
DB_NAME=konkan_bazaar

# ---- JWT Authentication ----
JWT_SECRET=your_jwt_secret_key_change_this
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_this

# ---- Public URLs ----
# Frontend origin(s). First entry is also the post-OAuth-login redirect target.
FRONTEND_URL=http://localhost:3000,http://localhost:3001
# Backend public URL — must match the OAuth redirect URIs whitelisted in the consoles.
BACKEND_URL=http://localhost:5000

# ---- Admin Panel ----
ADMIN_PANEL_PASSWORD=your_admin_panel_password

# ---- Razorpay Payment Gateway ----
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ---- SMTP / Email (transactional + promotional) ----
# Powers: signup welcome email, login welcome-back email, OTP, order updates,
# and the offer broadcast (emailing ALL users when a coupon is created in admin).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=hello@kokanghar.in

# ---- SMS (transactional order updates — MSG91 or Fast2SMS) ----
# Powers: order placed, confirmed, shipped, out-for-delivery, delivered,
# cancelled texts to the delivery-address phone (COD customers have no email).
# Set SMS_PROVIDER=none (or leave keys empty) to disable — the app then skips
# SMS silently and never fails an order.
SMS_PROVIDER=none            # none | msg91 | fast2sms
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=KOKNGR       # must match your DLT-approved sender id
MSG91_FLOW_ID=your_msg91_flow_id   # optional: DLT template flow id (recommended)
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_SENDER_ID=KOKNGR

# ---- Post-Delivery Lifecycle Emails ----
# Sent automatically by the backend scheduler: a "rate your order" email
# ~2-3 days after delivery, then a "restock favourites" reorder nudge ~14 days
# later. Each delivered order is emailed at most once per flow.
LIFECYCLE_EMAILS_ENABLED=true
LIFECYCLE_EMAILS_INTERVAL_MIN=60          # how often the scheduler sweeps
REVIEW_REQUEST_HOURS=48                   # review request after 48h (2 days)
REVIEW_REQUEST_WINDOW_HOURS=24            # ...and sent within the following 24h
REORDER_REMINDER_HOURS=336                # reorder nudge after 336h (14 days)

# ---- Wishlist Price-Drop Alerts ----
# Daily cron: when a wishlisted product's price drops >= PRICE_DROP_MIN_PERCENT
# (vs the price when added / last alert), the customer gets an in-app
# notification + email ("Cashew W240 ab Rs 150 sasta!").
PRICE_DROP_ALERTS_ENABLED=true
PRICE_DROP_ALERTS_INTERVAL_HOURS=24    # how often the sweep runs (daily)
PRICE_DROP_MIN_PERCENT=5               # min price drop % to trigger an alert

# ---- Rate Limiting ----
API_RATE_LIMIT=1000

# ---- Google OAuth (from Google Cloud Console) ----
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- Facebook OAuth (from Facebook Developer Console) ----
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ---- Frontend (NEXT_PUBLIC_* get inlined into the browser bundle) ----
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
NEXT_PUBLIC_ADMIN_KEY=your_admin_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HD406G3YL0
# GA4 Measurement Protocol API Secret (from GA4 Admin > Data Streams > Measurement Protocol)
GA4_API_SECRET=your_ga4_api_secret

# ---- Deployment (Railway) ----
# RAILWAY_STATIC_URL=https://your-app.railway.app

# ---- Optional: used only by backend/scripts/_update_admin_password.cjs ----
# NEW_ADMIN_PASSWORD=your_new_admin_password

# ---- Tunnel gateway (shared password for the public URL) ----
GATEWAY_USER=kokan
GATEWAY_PASS=your_shared_gateway_password
