# ============================================================
# KONKAN BAZAAR — .gitignore
# Monorepo: frontend/ + admin/ (Next.js), backend/ (Node/Express)
# ============================================================

# ---- Dependencies ----
node_modules/

# ---- Next.js build output (frontend + admin) ----
.next/
out/
build/

# ---- Backend ----
dist/
coverage/

# ---- Runtime uploads (backend serves these from disk) ----
backend/uploads/

# ---- Environment / secrets ----
# NEVER commit real .env files. The .env.example template IS committed.
.env
.env.local
.env.*.local
!.env.example

# ---- Logs ----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Images (large files, not for repo) ----
images/
images.zip

# ---- Local UI test screenshots (browser test artifacts) ----
frontend/frontend/
frontend/test-*.png

# ---- Misc / temp ----
.turbo/
.vercel/
.parcel-cache/
.cache/
*.tsbuildinfo
.eslintcache
